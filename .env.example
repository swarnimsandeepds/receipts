# Copy this file to .env.local and fill in the keys.
# Every integration must fall back to mock data when its key is missing.

# LLM (use one)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Discovery: https://tavily.com
TAVILY_API_KEY=

# Enrichment: https://hunter.io
HUNTER_API_KEY=

# Retrieval: https://portal.usemoss.dev
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=

# Billing: https://flexprice.io
FLEXPRICE_API_KEY=
FLEXPRICE_API_HOST=
# Optional: external customer id for usage events (default receipts-demo)
FLEXPRICE_CUSTOMER_ID=

# Optional: override the LLM model id
LLM_MODEL=
